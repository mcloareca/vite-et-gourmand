# Copier ce fichier en ".env" puis remplir les valeurs (ne jamais committer .env)
PORT=3000
NODE_ENV=development
# URL publique de l'application (utilisée dans les liens des e-mails)
APP_URL=http://localhost:3000
# Clé secrète des sessions : une longue chaîne aléatoire
SESSION_SECRET=changer-moi-par-une-longue-chaine-aleatoire
# PostgreSQL (Neon) : chaîne de connexion "postgresql://..."
DATABASE_URL=
# MongoDB (Atlas) : chaîne de connexion "mongodb+srv://..."
MONGODB_URI=
# E-mails (SMTP). Si SMTP_HOST est vide, les mails sont affichés dans la console.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vite & Gourmand <no-reply@vite-gourmand.fr>"
# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=contact@vite-gourmand.fr
