# Configuration des tests de bout en bout (npm run test:e2e).
# Copiez ce fichier en .env.test (ignoré par Git) et remplissez-le.
# ATTENTION : DATABASE_URL doit être une base de TEST, jamais celle de .env (production) :
# les tests effacent puis remplissent cette base. Le script refuse de démarrer sinon.

# Port de l'application de test (différent de celui de .env)
PORT=3001
NODE_ENV=test
APP_URL=http://localhost:3001

# Base PostgreSQL de test (par exemple une branche « test » du projet Neon)
DATABASE_URL=

# Laisser vide : les tests n'utilisent pas MongoDB (cela protège les statistiques de production)
MONGODB_URI=

# Mots de passe des comptes de démonstration (voir le manuel d'utilisation)
E2E_MDP_ADMIN=
E2E_MDP_EMPLOYE=
E2E_MDP_CLIENT=
