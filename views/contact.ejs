<%- include('partials/tete') %>
<h1>Nous contacter</h1>
<%- include('partials/erreurs') %>
<form class="formulaire" method="post" action="/contact">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="champ">
    <label for="titre">Titre de votre demande</label>
    <input id="titre" name="titre" required maxlength="100" value="<%= valeurs.titre || '' %>">
  </div>
  <div class="champ">
    <label for="description">Votre message</label>
    <textarea id="description" name="description" required maxlength="2000" rows="6"><%= valeurs.description || '' %></textarea>
  </div>
  <div class="champ">
    <label for="email">Votre e-mail (pour vous répondre)</label>
    <input type="email" id="email" name="email" required autocomplete="email" value="<%= valeurs.email || '' %>">
  </div>
  <button class="bouton" type="submit">Envoyer</button>
</form>
<%- include('partials/pied') %>
